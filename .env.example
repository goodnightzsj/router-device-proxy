# 建议绑定 LAN IP，例如 192.168.31.xx:18099
ADDR=:8090
ADMIN_PASSWORD=change-me
ROUTER_HOST=192.168.31.1
ROUTER_USER=root
# 可选：小米后台密码，用于读取 Xiaomi 设备显示名
ROUTER_WEB_PASSWORD=
# 可选：小米本地设备库路径
XIAOMI_XQDB=/data/etc/xqDb
# 旁路由（透明代理网关）地址，例如 192.168.31.xx；留空则需在设置页填写
PROXY_GATEWAY=
ROUTER_LEASE_FILE=/tmp/dhcp.leases
DISCOVERY=true
DISCOVERY_SSDP=true
DISCOVERY_TIMEOUT=2s
